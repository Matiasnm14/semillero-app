DB_NAME=semillero
DB_USER=semillero
DB_PASSWORD=cambiar_password_local
DB_PORT_EXTERNAL=5432
DB_URL=jdbc:postgresql://localhost:5432/semillero
SPRING_PROFILES_ACTIVE=dev
# Spring aplica las migraciones pendientes con Flyway y después valida el esquema.
DB_DDL_AUTO=validate

# HU01: ffmpeg y ffprobe deben estar instalados en el host del backend.
VIDEO_STORAGE_DIR=.local/videos
VIDEO_MAX_BYTES=2147483648
VIDEO_MAX_FILE_SIZE=2GB
VIDEO_MAX_REQUEST_SIZE=2049MB
VIDEO_VALIDATION_TIMEOUT=1h
# Activar después de autorizar el canal con scripts/youtube_upload.py authorize.
VIDEO_YOUTUBE_ENABLED=false
VIDEO_YOUTUBE_PYTHON=.local/youtube/venv/bin/python
VIDEO_YOUTUBE_CHANNEL=Semillero-Video-Analysis

# La carga autorizada responde 202 con original y trabajo persistidos.
# Con false el trabajo queda pendiente; el worker no despacha a Spark.
# Configurar la URL y credencial según docs/HU02_HU03_ANALISIS.md.
# El cupo de concurrencia limita las ejecuciones desde la cola persistida.
ANALYSIS_ENABLED=false
ANALYSIS_BASE_URL=
ANALYSIS_EVALUATION_PATH=/analyses
ANALYSIS_TOKEN=
ANALYSIS_POLL_INTERVAL=5s
ANALYSIS_CONNECT_TIMEOUT=10s
ANALYSIS_REQUEST_TIMEOUT=2h
ANALYSIS_LEASE_DURATION=30s
ANALYSIS_MAX_DURATION=6h
ANALYSIS_MAX_CONCURRENT_JOBS=1
ANALYSIS_MAX_RESPONSE_BYTES=1048576

ANALYSIS_READ_JERSEYS=true
ANALYSIS_ARTIFACTS_DIR=.local/analysis
ANALYSIS_MAX_HEATMAP_BYTES=10485760
