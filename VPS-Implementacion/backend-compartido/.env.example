APP_IMAGE=semillero-backend:REEMPLAZAR_POR_COMMIT
# Destino del backend en el Caddyfile verificado el 2026-11-02.
BACKEND_HOST_PORT=18083
# Usar la base compartida existente; no crear una base distinta por equipo.
# localhost dentro del contenedor no corresponde al host del VPS.
DB_URL=
DB_USER=
DB_PASSWORD=
# Generar un secreto aleatorio de al menos 32 bytes y conservarlo entre actualizaciones.
JWT_SECRET=
# Orígenes exactos separados por comas, sin slash final. Vacío: mismo origen.
CORS_ALLOWED_ORIGINS=
BACKEND_MEMORY_LIMIT=1g
BACKEND_CPUS=1.0

# Las rutas internas de videos, PNG y temporales ya apuntan al volumen backend_data.
# Spark y YouTube continúan deshabilitados en el perfil vps de esta entrega.
