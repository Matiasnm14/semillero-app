APP_IMAGE=semillero-backend:REEMPLAZAR_POR_COMMIT
# Docker rootless con network_mode: host, confirmado por el administrador.
# Spring escucha en 127.0.0.1:18083. No usar ports ni 172.20.0.2.
# Credenciales privadas existentes: /home/backend/proyecto/.env.db.
DB_URL=jdbc:postgresql://127.0.0.1:5432/semillero
DB_USER=
DB_PASSWORD=
# Generar un secreto aleatorio de al menos 32 bytes y conservarlo entre actualizaciones.
JWT_SECRET=
# Origen HTTPS de la web publicada, sin ruta ni barra final.
PUBLIC_WEB_ORIGIN=https://semillero.mandarina-group.cc
# Orígenes adicionales separados por comas; no incluir rutas ni barra final.
CORS_ALLOWED_ORIGINS=
BACKEND_MEMORY_LIMIT=1g
BACKEND_CPUS=1.0

# Las rutas internas de videos, PNG y temporales ya apuntan al volumen backend_data.
# Spark permanece deshabilitado hasta configurar el token y probar la conectividad.
ANALYSIS_ENABLED=false
ANALYSIS_WORKER_ENABLED=false
ANALYSIS_BASE_URL=https://spark-0aa4.tail763771.ts.net
ANALYSIS_TOKEN=
ANALYSIS_READ_JERSEYS=true
ANALYSIS_POLL_INTERVAL=5s
ANALYSIS_CONNECT_TIMEOUT=10s
ANALYSIS_REQUEST_TIMEOUT=2h
ANALYSIS_MAX_DURATION=6h
ANALYSIS_MAX_RESPONSE_BYTES=16777216
# Instalar OAuth en el volumen privado antes de activar estos interruptores.
VIDEO_YOUTUBE_ENABLED=false
VIDEO_YOUTUBE_WORKER_ENABLED=false
VIDEO_YOUTUBE_CHANNEL=Semillero-Video-Analysis
# Flyway se ejecuta mediante el migrador central; el runtime usa Hibernate validate.
