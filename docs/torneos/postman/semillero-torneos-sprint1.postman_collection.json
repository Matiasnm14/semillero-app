{
  "info": {
    "name": "SEMILLERO · Torneos · Sprint 1",
    "description": "Prueba de punta a punta del sprint 1 del modulo de Torneos (Grupo 4).\n\nCubre HU 1 (S1-08, S1-09, S1-10), HU 2 (S1-12, S1-13), HU 3 (S1-16, S1-17) y HU 4 (S1-20, S1-21), con sus casos de error.\n\nCorrela entera con Run collection: cada carpeta deja en variables los IDs que usa la siguiente. Las fechas se calculan solas respecto de hoy, asi que no se vence.\n\nRequiere la API levantada con el perfil dev en {{baseUrl}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fechas relativas a hoy: la ventana de inscripcion depende de now(),",
          "// asi que con fechas fijas la coleccion se vencia.",
          "const hoy = new Date();",
          "const masDias = (n) => new Date(hoy.getTime() + n * 86400000).toISOString().slice(0, 10);",
          "pm.collectionVariables.set('fechaLimite', masDias(10));",
          "pm.collectionVariables.set('fechaInicio', masDias(20));",
          "pm.collectionVariables.set('fechaFin', masDias(120));",
          "pm.collectionVariables.set('temporada', String(new Date(hoy.getTime() + 20 * 86400000).getFullYear()));",
          "pm.collectionVariables.set('sufijo', String(Date.now()));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 · Datos base",
      "description": "Crea pais, ciudad, tres clubes y dos usuarios usando los endpoints que ya existian. Guarda sus IDs.",
      "item": [
        {
          "name": "Crear pais",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombrePais\": \"Bolivia\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/paises" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.test('trae header Location', () => pm.expect(pm.response.headers.has('Location')).to.be.true);",
            "pm.collectionVariables.set('paisId', pm.response.json().id);"
          ]}}]
        },
        {
          "name": "Crear ciudad",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombreCiudad\": \"Santa Cruz\",\n  \"paisId\": {{paisId}}\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/ciudades" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('ciudadId', pm.response.json().id);"
          ]}}]
        },
        {
          "name": "Crear club A",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombreClub\": \"Club A\",\n  \"ciudadId\": {{ciudadId}}\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/clubes" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('clubAId', pm.response.json().id);"
          ]}}]
        },
        {
          "name": "Crear club B",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombreClub\": \"Club B\",\n  \"ciudadId\": {{ciudadId}}\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/clubes" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('clubBId', pm.response.json().id);"
          ]}}]
        },
        {
          "name": "Crear club C",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombreClub\": \"Club C\",\n  \"ciudadId\": {{ciudadId}}\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/clubes" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('clubCId', pm.response.json().id);"
          ]}}]
        },
        {
          "name": "Crear usuario organizador",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"organizador\",\n  \"nombres\": \"Miguel\",\n  \"apellidos\": \"Lopez\",\n  \"email\": \"organizador{{sufijo}}@example.com\",\n  \"password\": \"secreto123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/usuarios" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.test('nunca devuelve la contrasena', () => {",
            "  pm.expect(pm.response.json()).to.not.have.property('password');",
            "  pm.expect(pm.response.json()).to.not.have.property('passwordHash');",
            "});",
            "pm.collectionVariables.set('organizadorId', pm.response.json().id);"
          ]}}]
        },
        {
          "name": "Crear usuario entrenador",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"entrenador\",\n  \"nombres\": \"Alan\",\n  \"apellidos\": \"Villavicencio\",\n  \"email\": \"entrenador{{sufijo}}@example.com\",\n  \"password\": \"secreto123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/usuarios" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('entrenadorId', pm.response.json().id);"
          ]}}]
        }
      ]
    },
    {
      "name": "01 · HU 1 Crear torneo · S1-08 S1-09 S1-10",
      "item": [
        {
          "name": "Crear torneo con dos categorias",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Copa Semillero\",\n  \"temporada\": {{temporada}},\n  \"tipo\": \"OFICIAL\",\n  \"ambito\": \"INTERNO\",\n  \"formato\": \"LIGA\",\n  \"idaVuelta\": false,\n  \"fechaInicio\": \"{{fechaInicio}}\",\n  \"fechaFin\": \"{{fechaFin}}\",\n  \"fechaLimiteInscripcion\": \"{{fechaLimite}}\",\n  \"usuarioId\": {{organizadorId}},\n  \"categorias\": [\n    {\n      \"nombre\": \"Sub-12\",\n      \"edadMinima\": 10,\n      \"edadMaxima\": 12,\n      \"cupoMaximo\": 2,\n      \"duracionTiempoMin\": 30,\n      \"jugadoresEnCancha\": 9,\n      \"maxSustituciones\": 5\n    },\n    {\n      \"nombre\": \"Sub-14\",\n      \"edadMinima\": 12,\n      \"edadMaxima\": 14,\n      \"cupoMaximo\": 8,\n      \"duracionTiempoMin\": 35,\n      \"jugadoresEnCancha\": 11,\n      \"maxSustituciones\": 5\n    }\n  ]\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/torneos" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const t = pm.response.json();",
            "pm.test('S1-10 nace en BORRADOR', () => pm.expect(t.estado).to.eql('BORRADOR'));",
            "pm.test('INTERNO no guarda organizador externo', () => pm.expect(t.organizadorExterno).to.be.oneOf([null, undefined]));",
            "pm.test('guarda fechaCreacion', () => pm.expect(t.fechaCreacion).to.be.a('string'));",
            "pm.collectionVariables.set('torneoId', t.id);"
          ]}}]
        },
        {
          "name": "Ver el torneo",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/torneos/{{torneoId}}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('es el organizador que mandamos', () => pm.expect(pm.response.json().usuarioId).to.eql(Number(pm.collectionVariables.get('organizadorId'))));"
          ]}}]
        },
        {
          "name": "S1-09 listar las categorias",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/torneos/{{torneoId}}/categorias?size=100" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const p = pm.response.json();",
            "pm.test('las dos categorias inline se guardaron', () => pm.expect(p.totalElements).to.eql(2));",
            "pm.test('con su rango de edad', () => pm.expect(p.content[0].edadMaxima).to.eql(12));",
            "pm.collectionVariables.set('categoriaSub12Id', p.content[0].id);",
            "pm.collectionVariables.set('categoriaSub14Id', p.content[1].id);"
          ]}}]
        },
        {
          "name": "S1-09 agregar una categoria mas",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Sub-16\",\n  \"edadMinima\": 14,\n  \"edadMaxima\": 16,\n  \"cupoMaximo\": 10,\n  \"duracionTiempoMin\": 40,\n  \"jugadoresEnCancha\": 11,\n  \"maxSustituciones\": 5\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/torneos/{{torneoId}}/categorias" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.test('pertenece al torneo', () => pm.expect(pm.response.json().torneoId).to.eql(Number(pm.collectionVariables.get('torneoId'))));"
          ]}}]
        },
        {
          "name": "S1-10 abrir inscripciones",
          "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/torneos/{{torneoId}}/abrir-inscripciones" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('S1-10 pasa a INSCRIPCIONES_ABIERTAS', () => pm.expect(pm.response.json().estado).to.eql('INSCRIPCIONES_ABIERTAS'));"
          ]}}]
        },
        {
          "name": "S1-10 abrirlas dos veces da 409",
          "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/torneos/{{torneoId}}/abrir-inscripciones" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
            "pm.test('explica el motivo', () => pm.expect(pm.response.json().detail).to.include('BORRADOR'));"
          ]}}]
        },
        {
          "name": "Listado paginado de torneos",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/torneos?size=100&sort=id,desc" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const p = pm.response.json();",
            "pm.test('devuelve PageResponse', () => {",
            "  pm.expect(p).to.have.property('content');",
            "  pm.expect(p).to.have.property('totalElements');",
            "  pm.expect(p.size).to.eql(100);",
            "});"
          ]}}]
        }
      ]
    },
    {
      "name": "02 · HU 1 validaciones que deben fallar",
      "item": [
        {
          "name": "fechaFin anterior a fechaInicio da 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Copa invalida\",\n  \"temporada\": {{temporada}},\n  \"tipo\": \"OFICIAL\",\n  \"ambito\": \"INTERNO\",\n  \"formato\": \"LIGA\",\n  \"fechaInicio\": \"{{fechaFin}}\",\n  \"fechaFin\": \"{{fechaInicio}}\",\n  \"fechaLimiteInscripcion\": \"{{fechaLimite}}\",\n  \"usuarioId\": {{organizadorId}}\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/torneos" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('dice que es por la fecha de fin', () => pm.expect(pm.response.json().detail).to.include('fecha de fin'));"
          ]}}]
        },
        {
          "name": "EXTERNO sin organizador da 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Campeonato externo\",\n  \"temporada\": {{temporada}},\n  \"tipo\": \"OFICIAL\",\n  \"ambito\": \"EXTERNO\",\n  \"formato\": \"LIGA\",\n  \"fechaInicio\": \"{{fechaInicio}}\",\n  \"fechaFin\": \"{{fechaFin}}\",\n  \"fechaLimiteInscripcion\": \"{{fechaLimite}}\",\n  \"usuarioId\": {{organizadorId}}\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/torneos" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('exige el organizador externo', () => pm.expect(pm.response.json().detail).to.include('EXTERNO'));"
          ]}}]
        },
        {
          "name": "EXTERNO con organizador si se crea",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Campeonato externo\",\n  \"temporada\": {{temporada}},\n  \"tipo\": \"OFICIAL\",\n  \"ambito\": \"EXTERNO\",\n  \"organizadorExterno\": \"Liga Crucena\",\n  \"formato\": \"LIGA\",\n  \"fechaInicio\": \"{{fechaInicio}}\",\n  \"fechaFin\": \"{{fechaFin}}\",\n  \"fechaLimiteInscripcion\": \"{{fechaLimite}}\",\n  \"usuarioId\": {{organizadorId}}\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/torneos" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.test('guarda el organizador externo', () => pm.expect(pm.response.json().organizadorExterno).to.eql('Liga Crucena'));"
          ]}}]
        },
        {
          "name": "Sin nombre da 400 con el campo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"temporada\": {{temporada}},\n  \"tipo\": \"OFICIAL\",\n  \"ambito\": \"INTERNO\",\n  \"formato\": \"LIGA\",\n  \"fechaInicio\": \"{{fechaInicio}}\",\n  \"fechaFin\": \"{{fechaFin}}\",\n  \"fechaLimiteInscripcion\": \"{{fechaLimite}}\",\n  \"usuarioId\": {{organizadorId}}\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/torneos" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('nombra el campo que falta', () => pm.expect(pm.response.json().errors).to.have.property('nombre'));"
          ]}}]
        },
        {
          "name": "Organizador inexistente da 404",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Copa sin organizador\",\n  \"temporada\": {{temporada}},\n  \"tipo\": \"OFICIAL\",\n  \"ambito\": \"INTERNO\",\n  \"formato\": \"LIGA\",\n  \"fechaInicio\": \"{{fechaInicio}}\",\n  \"fechaFin\": \"{{fechaFin}}\",\n  \"fechaLimiteInscripcion\": \"{{fechaLimite}}\",\n  \"usuarioId\": 999999999\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/torneos" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
