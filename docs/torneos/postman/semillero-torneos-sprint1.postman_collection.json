    {
      "name": "03 · HU 2 Reglamento · S1-12 S1-13",
      "item": [
        {
          "name": "S1-13 catalogo de criterios de desempate",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/torneos/criterios-desempate?size=100" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('los 5 criterios del script estan sembrados', () => pm.expect(pm.response.json().totalElements).to.eql(5));",
            "const codigos = pm.response.json().content.map(c => c.codigo);",
            "pm.test('estan los esperados', () => pm.expect(codigos).to.include.members(['DIF_GOLES','GOLES_FAVOR','ENFRENTAMIENTO','FAIR_PLAY','SORTEO']));"
          ]}}]
        },
        {
          "name": "S1-12 crear el reglamento",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"umbralAmarillas\": 5,\n  \"minJugadores\": 11,\n  \"maxJugadores\": 18,\n  \"desempates\": [\"DIF_GOLES\", \"GOLES_FAVOR\", \"ENFRENTAMIENTO\"]\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/torneos/{{torneoId}}/reglamento" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const r = pm.response.json();",
            "pm.test('toma los valores por defecto del script', () => {",
            "  pm.expect(r.puntosVictoria).to.eql(3);",
            "  pm.expect(r.puntosEmpate).to.eql(1);",
            "  pm.expect(r.puntosDerrota).to.eql(0);",
            "  pm.expect(r.descansoMinimoMin).to.eql(60);",
            "});",
            "pm.test('fechaCorte por defecto es 31/12 de la temporada', () => pm.expect(r.fechaCorte).to.eql(pm.collectionVariables.get('temporada') + '-12-31'));",
            "pm.test('S1-13 guarda el orden de los desempates', () => pm.expect(r.desempates).to.eql(['DIF_GOLES','GOLES_FAVOR','ENFRENTAMIENTO']));"
          ]}}]
        },
        {
          "name": "S1-13 ver el orden de los desempates",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/torneos/{{torneoId}}/reglamento/desempates" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const d = pm.response.json();",
            "pm.test('tres criterios con orden 1, 2, 3', () => {",
            "  pm.expect(d.length).to.eql(3);",
